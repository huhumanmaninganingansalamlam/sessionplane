{
  "name": "sessionplane",
  "version": "0.4.113",
  "description": "Durable local runtime for role-addressed browser-backed AI chat sessions",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "bin": {
    "sessplane": "bin/sessplane.mjs"
  },
  "files": [
    "bin/sessplane.mjs",
    "bin/runtime-state.mjs",
    "dist",
    "skills",
    "README.md",
    "scripts/offline-state-rehearsal.mjs"
  ],
  "scripts": {
    "prepack": "npm run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/release-preflight.mjs --emit-build-identity",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:docs": "node scripts/verify-doc-authority.mjs",
    "lint:architecture": "node scripts/verify-source-architecture.mjs",
    "lint:quality": "node scripts/verify-source-quality.mjs",
    "lint": "npm run lint:docs && npm run lint:architecture && npm run lint:quality && npm run lint:tests",
    "verify:repository": "node scripts/verify-repository-quality.mjs",
    "test": "node scripts/run-test-suite.mjs checks",
    "test:ci": "node scripts/run-test-suite.mjs ci",
    "test:acceptance": "node scripts/run-test-suite.mjs acceptance",
    "test:reliability": "node scripts/run-test-suite.mjs reliability",
    "test:package": "node scripts/run-test-suite.mjs package",
    "release:preflight": "node scripts/release-preflight.mjs",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "doctor": "node --experimental-strip-types src/cli/main.ts doctor --json",
    "start": "node dist/main.js",
    "verify": "npm run lint && npm run verify:repository && npm run typecheck && npm test && npm run build && npm run doctor",
    "verify:clean": "node scripts/clean-checkout-gate.mjs",
    "test:browser": "node scripts/run-test-suite.mjs browser",
    "test:live-preflight": "node scripts/run-test-suite.mjs live-preflight",
    "test:live-task": "node scripts/run-test-suite.mjs live-task",
    "test:background-l2": "node scripts/run-test-suite.mjs background-l2",
    "test:browser-transport-l2": "node scripts/run-test-suite.mjs browser-transport-l2",
    "test:candidate": "node scripts/run-test-suite.mjs candidate",
    "lint:tests": "node scripts/verify-test-suite-manifest.mjs"
  },
  "dependencies": {
    "playwright-core": "1.64.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "7.0.2"
  }
}
